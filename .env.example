# Suite-wide environment. Copy to .env.local and fill in what you need.

# Optional. Without it every model step serves the canned output shipped with the seed.
ANTHROPIC_API_KEY=

# Model string for model steps. Defaults to claude-sonnet-5 when unset.
DEMO_MODEL=claude-sonnet-5

# Which annotation set the explanation panel shows: client (default) or internal.
NEXT_PUBLIC_DEMO_AUDIENCE=client
